# Template for web/.env.local (gitignored — never commit real values).
# Self-hosting? SELF_HOSTING.md walks through where each value comes from.

# --- Supabase ---------------------------------------------------------------
# Your Supabase project → Settings → API (URL, anon key, service_role key).
# The service_role key bypasses all database security — server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Plary plugin JWTs ------------------------------------------------------
# Signing secret for plugin tokens. Generate once: openssl rand -hex 32
# Must be the same value locally and in your deployment (they share the DB and
# the plugin stores one token). Rotating it logs every plugin user out.
PLARY_TOKEN_SECRET=

# --- Figma OAuth ------------------------------------------------------------
# Your app at https://www.figma.com/developers/apps
# Register <your-app-url>/api/figma/oauth/callback (and the localhost variant
# for dev) as redirect URIs, then publish the app — an unpublished app only
# works for its creator.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
NEXT_PUBLIC_FIGMA_CLIENT_ID=

# Encrypts stored Figma tokens (AES-256-GCM). Generate once: openssl rand -hex 32
# Must match between local and deployment for the same database. Rotating it
# makes every stored Figma connection undecryptable (users reconnect once).
FIGMA_ENCRYPTION_KEY=

# --- Optional ---------------------------------------------------------------
# Shown as the contact address on the privacy page. Omit to hide the section.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Comma-separated Supabase OAuth providers to offer on the login pages, e.g.
# "google,azure". Each must also be enabled in Supabase → Authentication →
# Providers. Omit for magic-link-only login.
NEXT_PUBLIC_AUTH_PROVIDERS=
